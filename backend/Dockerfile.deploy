# Lean production image (Render) — shared by two SEPARATE services, the
# API and the worker, each with its own start command override
# (start-render.sh / start-worker.sh) rather than sharing one container.
# See docs/checkpoints/phase-5.md: the worker alone needed ~662MB at
# runtime, already over the 512MB free-tier limit by itself, so combining
# it with the API was never going to fit either way — splitting them plus
# switching embeddings off local torch (see app/kb/embeddings.py) is what
# actually fixed it (worker now runs at ~287MB).
#
# Deliberately NOT the dev Dockerfile's `uv sync` against pyproject.toml:
# that installs Unsloth + a CUDA-flavored torch build (10-20GB) for the
# cheap-tier drafting model. That model never runs in this deployment —
# CHEAP_TIER_URGENCY_THRESHOLD=0 routes every ticket to the Groq-hosted
# strong tier instead, so unsloth's own lazy import (cheap_tier.py's
# _load_model()) is never reached. This image installs a curated,
# CPU-only dependency set instead (requirements-deploy.txt) — see
# docs/checkpoints/phase-5.md for the full reasoning.
#
# Build context is the REPO ROOT (Render's default when no Root Directory
# is set) — every COPY below is prefixed backend/ accordingly, so this
# doesn't depend on guessing Render's exact context-resolution behavior.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-deploy.txt ./
RUN pip install --no-cache-dir -r requirements-deploy.txt
RUN pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY backend/start-render.sh ./start-render.sh
COPY backend/start-worker.sh ./start-worker.sh
RUN chmod +x ./start-render.sh ./start-worker.sh

# Trained artifacts baked into the image — both are tiny (~100KB combined)
# and already committed to git (see .gitignore's comments on which ML
# artifacts are NOT tracked, and why). The LoRA cheap-tier adapter is
# deliberately absent here: never loaded at this threshold, gitignored,
# and a git-based cloud build wouldn't have it even if it were needed.

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Default CMD is the API. The worker service overrides this via Render's
# "Docker Command" field to ./start-worker.sh instead — same image, same
# dependencies, different entrypoint.
CMD ["./start-render.sh"]
