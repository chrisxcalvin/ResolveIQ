# Postgres — Neon (cloud, see README "Quick start"). Fill in your own
# Neon connection string, driver prefix changed to postgresql+asyncpg://
# and ?sslmode=require/&channel_binding=require simplified to ?ssl=require.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<your-neon-host>/<db>?ssl=require

# Local/offline alternative (see README "Local/offline alternative"):
# POSTGRES_USER=resolveiq
# POSTGRES_PASSWORD=resolveiq_dev_password
# POSTGRES_DB=resolveiq
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://resolveiq:resolveiq_dev_password@localhost:5432/resolveiq

# Redis — Upstash (cloud). rediss:// (double-s) for TLS, and
# ?ssl_cert_reqs=CERT_REQUIRED is REQUIRED — Celery's redis backend
# refuses to start on a rediss:// URL without it.
REDIS_URL=rediss://default:<password>@<your-upstash-host>:6379?ssl_cert_reqs=CERT_REQUIRED
# Local/offline alternative:
# REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Drafting agent - strong tier (Groq-hosted, only used for harder/high-urgency tickets)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHEAP_TIER_URGENCY_THRESHOLD=0.5

# Tracing (optional) - leave both blank to disable Langfuse cleanly, no code changes needed
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
