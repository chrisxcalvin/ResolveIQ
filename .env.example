# Postgres
POSTGRES_USER=resolveiq
POSTGRES_PASSWORD=resolveiq_dev_password
POSTGRES_DB=resolveiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://resolveiq:resolveiq_dev_password@localhost:5432/resolveiq

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Drafting agent - strong tier (Groq-hosted, only used for harder/high-urgency tickets)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHEAP_TIER_URGENCY_THRESHOLD=0.5
